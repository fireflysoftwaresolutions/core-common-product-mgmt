-- Explicit administrator preparation after exact original20, before restricted V21 startup.
\set ON_ERROR_STOP on
\getenv preparation_database PRODUCT_PUBLICATION_PREPARATION_DATABASE
\getenv preparation_old_owner PRODUCT_PUBLICATION_PREPARATION_OLD_OWNER
\if :{?preparation_database}
\else
DO $missing$ BEGIN RAISE EXCEPTION 'METADATA_OWNER_PREPARATION_INPUTS_REQUIRED'; END $missing$;
\endif
\if :{?preparation_old_owner}
\else
DO $missing$ BEGIN RAISE EXCEPTION 'METADATA_OWNER_PREPARATION_INPUTS_REQUIRED'; END $missing$;
\endif
SELECT current_database()=:'preparation_database' AND current_user=session_user
   AND session_user=:'preparation_old_owner'
   AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname=current_user AND (rolsuper OR rolbypassrls))
   AND current_setting('server_encoding')='UTF8' AS preparation_inputs_ok
\gset
\if :preparation_inputs_ok
\else
DO $missing$ BEGIN RAISE EXCEPTION 'EXACT_ORIGINAL20_ADMINISTRATOR_REQUIRED'; END $missing$;
\endif
BEGIN;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='15s';
DO $preparation$
DECLARE
    expected_old_owner OID := (SELECT oid FROM pg_catalog.pg_roles WHERE rolname=session_user);
    metadata_owner OID;
    guard_owner OID;
    role_row RECORD;
    item RECORD;
    targets TEXT[] := ARRAY['product_definition_action','product_definition_control','product_definition_history',
        'product_definition_publication','product_definition_publication_control','product_definition_review',
        'product_definition_review_private','product_definition_revision','product_definition_root'];
    guard_tables TEXT[] := ARRAY['product_definition_submission','product_definition_review_decision','product_definition_version_identity'];
    target_oids OID[];
    dependent_relations OID[];
    dependent_types OID[];
    preparation_mode TEXT;
    old_count INTEGER;
    prepared_count INTEGER;
    phase INTEGER;
    original20_checksums JSONB;
    expected_checksums JSONB := '{"1":"-1652405854","10":"-538019164","11":"-229680836","12":"1952038624","13":"-1809386986","14":"1200475438","15":"-1124350550","16":"-2057734533","17":"1865613483","18":"1260037375","19":"1925386892","2":"296761191","20":"497655342","3":"547026953","4":"-985242886","5":"1798071846","6":"-236325576","7":"-77966026","8":"1917436903","9":"1951091242"}'::JSONB;
    owner_before JSONB; owner_after JSONB; owner_expected JSONB;
    acl_before JSONB; acl_after JSONB; acl_expected JSONB;
    structure_before JSONB; structure_after JSONB;
    rights_before JSONB; rights_after JSONB;
    current_owners JSONB; current_acl JSONB; current_expected_acl JSONB; current_structure JSONB; current_rights JSONB;
    schema_acl_before JSONB; schema_acl_after JSONB;
    temporary_create_grantor OID;
    temporary_grants INTEGER;
    target_owner_before JSONB; target_owner_after JSONB;
BEGIN
    SELECT jsonb_object_agg(version,checksum::TEXT) INTO original20_checksums FROM public.flyway_schema_history
        WHERE success AND version IS NOT NULL;
    IF original20_checksums IS DISTINCT FROM expected_checksums
       OR (SELECT count(*) FROM public.flyway_schema_history)<>20
       OR EXISTS (SELECT 1 FROM public.flyway_schema_history WHERE NOT success OR version IS NULL) THEN
        RAISE EXCEPTION 'EXACT_ORIGINAL20_HISTORY_REQUIRED';
    END IF;
    SELECT oid INTO guard_owner FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_guard'
        AND NOT rolcanlogin AND NOT rolsuper AND NOT rolbypassrls AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication;
    IF guard_owner IS NULL OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member=guard_owner) THEN
        RAISE EXCEPTION 'EXACT_EXISTING_GUARD_REQUIRED';
    END IF;
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_metadata_owner';
    IF NOT FOUND THEN
        CREATE ROLE firefly_product_definition_metadata_owner NOLOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS
            NOCREATEDB NOCREATEROLE NOREPLICATION;
    END IF;
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_metadata_owner';
    metadata_owner := role_row.oid;
    IF role_row.rolcanlogin OR role_row.rolinherit OR role_row.rolsuper OR role_row.rolbypassrls
       OR role_row.rolcreatedb OR role_row.rolcreaterole OR role_row.rolreplication
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member=metadata_owner)
       OR pg_catalog.has_schema_privilege(metadata_owner,'public','CREATE')
       OR pg_catalog.has_schema_privilege(metadata_owner,'firefly_product_definition_private','USAGE,CREATE')
       OR pg_catalog.has_database_privilege(metadata_owner,current_database(),'CREATE,TEMPORARY')
       OR NOT pg_catalog.pg_has_role(current_user,metadata_owner,'SET') THEN
        RAISE EXCEPTION 'EXACT_PROTECTED_METADATA_OWNER_REQUIRED';
    END IF;
    SELECT array_agg(c.oid ORDER BY c.relname),count(*) FILTER (WHERE c.relowner=expected_old_owner),
        count(*) FILTER (WHERE c.relowner=metadata_owner)
        INTO target_oids,old_count,prepared_count
        FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
        WHERE n.nspname='public' AND c.relname=ANY(targets) AND c.relkind='r'
          AND c.relrowsecurity AND c.relforcerowsecurity AND NOT c.relispartition;
    IF cardinality(target_oids) IS DISTINCT FROM 9
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_inherits WHERE inhrelid=ANY(target_oids) OR inhparent=ANY(target_oids))
       OR (SELECT count(*) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
           WHERE n.nspname='public' AND c.relname=ANY(guard_tables) AND c.relkind='r' AND c.relowner=guard_owner
             AND c.relrowsecurity AND c.relforcerowsecurity)<>3 THEN
        RAISE EXCEPTION 'EXACT_NINE_PLUS_THREE_OBJECTS_REQUIRED';
    END IF;
    IF old_count=9 AND prepared_count=0 THEN preparation_mode:='TRANSFERRED';
    ELSIF prepared_count=9 AND old_count=0 THEN preparation_mode:='ALREADY_PREPARED';
    ELSE RAISE EXCEPTION 'REVIEW_BOUND_OLD_OWNER_MAPPING_REQUIRED'; END IF;
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_depend d JOIN pg_catalog.pg_class c ON c.oid=d.objid
        WHERE d.classid='pg_catalog.pg_class'::REGCLASS AND d.refclassid='pg_catalog.pg_class'::REGCLASS
          AND d.refobjid=ANY(target_oids) AND d.deptype IN ('a','i') AND c.relkind='S') THEN
        RAISE EXCEPTION 'UNEXPECTED_OWNED_SEQUENCE';
    END IF;
    WITH RECURSIVE owned(oid) AS (
        SELECT unnest(target_oids)
        UNION
        SELECT d.child FROM owned o JOIN LATERAL (
            SELECT indexrelid AS child FROM pg_catalog.pg_index WHERE indrelid=o.oid
            UNION SELECT reltoastrelid FROM pg_catalog.pg_class WHERE oid=o.oid AND reltoastrelid<>0
        ) d ON TRUE
    ) SELECT array_agg(oid ORDER BY oid) INTO dependent_relations FROM owned;
    SELECT array_agg(DISTINCT t.oid ORDER BY t.oid) INTO dependent_types FROM pg_catalog.pg_type t
        WHERE t.typrelid=ANY(target_oids) OR t.oid IN (
            SELECT typarray FROM pg_catalog.pg_type WHERE typrelid=ANY(target_oids) AND typarray<>0);
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_class WHERE oid=ANY(dependent_relations)
        AND relowner<>CASE WHEN preparation_mode='TRANSFERRED' THEN expected_old_owner ELSE metadata_owner END)
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_type WHERE oid=ANY(dependent_types)
        AND typowner<>CASE WHEN preparation_mode='TRANSFERRED' THEN expected_old_owner ELSE metadata_owner END) THEN
        RAISE EXCEPTION 'UNEXPECTED_DEPENDENT_OWNER';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_shdepend d WHERE d.refclassid='pg_catalog.pg_authid'::REGCLASS
        AND d.refobjid=metadata_owner AND d.deptype='o' AND NOT (
            d.dbid=(SELECT oid FROM pg_catalog.pg_database WHERE datname=current_database())
            AND ((d.classid='pg_catalog.pg_class'::REGCLASS AND d.objid=ANY(dependent_relations))
              OR (d.classid='pg_catalog.pg_type'::REGCLASS AND d.objid=ANY(dependent_types))))) THEN
        RAISE EXCEPTION 'METADATA_OWNER_HAS_UNRELATED_OBJECTS';
    END IF;
    FOR item IN SELECT unnest(targets||guard_tables) AS name ORDER BY name LOOP
        EXECUTE pg_catalog.format('LOCK TABLE ONLY public.%I IN ACCESS EXCLUSIVE MODE',item.name);
    END LOOP;
    IF (SELECT count(*) FROM pg_catalog.pg_class WHERE oid=ANY(target_oids)
        AND relowner=CASE WHEN preparation_mode='TRANSFERRED' THEN expected_old_owner ELSE metadata_owner END)<>9
       OR (SELECT count(*) FROM pg_catalog.pg_class WHERE relnamespace='public'::REGNAMESPACE AND relname=ANY(guard_tables)
           AND relowner=guard_owner AND relrowsecurity AND relforcerowsecurity)<>3 THEN
        RAISE EXCEPTION 'OLD_OWNER_CHANGED_BEFORE_LOCK';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
        WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND c.relkind IN ('r','p','v','m','f')
          AND c.oid<>ALL(target_oids)
          AND (pg_catalog.has_table_privilege(metadata_owner,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
            OR pg_catalog.has_any_column_privilege(metadata_owner,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')))
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_proc p WHERE p.proowner=guard_owner
          AND pg_catalog.has_function_privilege(metadata_owner,p.oid,'EXECUTE')) THEN
        RAISE EXCEPTION 'METADATA_OWNER_HAS_UNRELATED_PRIVILEGES';
    END IF;
    SELECT jsonb_agg(to_jsonb(a) ORDER BY a.grantor,a.grantee,a.privilege_type,a.is_grantable)
        INTO schema_acl_before FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL
        pg_catalog.aclexplode(COALESCE(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) a WHERE n.nspname='public';
    FOR phase IN 0..1 LOOP
        IF phase=1 AND preparation_mode='TRANSFERRED' THEN
            IF pg_catalog.has_schema_privilege(metadata_owner,'public','CREATE') THEN
                RAISE EXCEPTION 'PREEXISTING_METADATA_OWNER_CREATE_REJECTED';
            END IF;
            GRANT CREATE ON SCHEMA public TO firefly_product_definition_metadata_owner;
            SELECT count(*),(array_agg(a.grantor))[1] INTO temporary_grants,temporary_create_grantor
                FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL pg_catalog.aclexplode(n.nspacl) a
                WHERE n.nspname='public' AND a.grantee=metadata_owner AND a.privilege_type='CREATE' AND NOT a.is_grantable;
            IF temporary_grants<>1 THEN RAISE EXCEPTION 'EXACT_TEMPORARY_CREATE_GRANT_REQUIRED'; END IF;
            FOR item IN SELECT unnest(targets) AS name ORDER BY name LOOP
                EXECUTE pg_catalog.format('ALTER TABLE ONLY public.%I OWNER TO firefly_product_definition_metadata_owner',item.name);
            END LOOP;
            IF (SELECT count(*) FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL pg_catalog.aclexplode(n.nspacl) a
                WHERE n.nspname='public' AND a.grantee=metadata_owner AND a.grantor=temporary_create_grantor
                  AND a.privilege_type='CREATE' AND NOT a.is_grantable)<>1 THEN
                RAISE EXCEPTION 'TEMPORARY_CREATE_GRANT_CHANGED';
            END IF;
            REVOKE CREATE ON SCHEMA public FROM firefly_product_definition_metadata_owner;
        END IF;
        SELECT jsonb_object_agg(k,to_jsonb(owner_id::BIGINT)) INTO current_owners FROM (
            SELECT 'relation/'||c.oid AS k,c.relowner AS owner_id FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND (n.nspname NOT LIKE 'pg_%' OR c.oid=ANY(dependent_relations))
            UNION ALL SELECT 'type/'||t.oid,t.typowner FROM pg_catalog.pg_type t JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
            UNION ALL SELECT 'function/'||p.oid,p.proowner FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
            UNION ALL SELECT 'schema/'||oid,nspowner FROM pg_catalog.pg_namespace WHERE nspname NOT LIKE 'pg_%' AND nspname<>'information_schema'
            UNION ALL SELECT 'database/'||oid,datdba FROM pg_catalog.pg_database WHERE datname=current_database()
        ) owners;
        WITH raw AS (
            SELECT 'table/'||c.oid AS object_key,a.* FROM pg_catalog.pg_class c CROSS JOIN LATERAL
                pg_catalog.aclexplode(COALESCE(c.relacl,pg_catalog.acldefault('r',c.relowner))) a WHERE c.oid=ANY(target_oids)
            UNION ALL SELECT 'column/'||c.oid||'/'||col.attnum,a.* FROM pg_catalog.pg_class c
                JOIN pg_catalog.pg_attribute col ON col.attrelid=c.oid AND col.attnum>0 AND NOT col.attisdropped
                CROSS JOIN LATERAL pg_catalog.aclexplode(col.attacl) a WHERE c.oid=ANY(target_oids)
            UNION ALL SELECT 'type/'||t.oid,a.* FROM pg_catalog.pg_type t CROSS JOIN LATERAL
                pg_catalog.aclexplode(COALESCE(t.typacl,pg_catalog.acldefault('T',t.typowner))) a WHERE t.oid=ANY(dependent_types)
        ), transformed AS (
            SELECT object_key,
                CASE WHEN phase=0 AND preparation_mode='TRANSFERRED' AND grantor=expected_old_owner THEN metadata_owner ELSE grantor END AS grantor,
                CASE WHEN phase=0 AND preparation_mode='TRANSFERRED' AND grantee=expected_old_owner THEN metadata_owner ELSE grantee END AS grantee,
                privilege_type,bool_or(is_grantable) AS is_grantable FROM raw GROUP BY object_key,2,3,privilege_type
        ) SELECT (SELECT jsonb_agg(to_jsonb(r) ORDER BY object_key,grantor,grantee,privilege_type,is_grantable) FROM raw r),
            (SELECT jsonb_agg(to_jsonb(t) ORDER BY object_key,grantor,grantee,privilege_type,is_grantable) FROM transformed t)
            INTO current_acl,current_expected_acl;
        WITH roles AS (
            SELECT DISTINCT r.oid,r.rolname FROM pg_catalog.pg_roles r WHERE r.oid<>expected_old_owner AND EXISTS (
                SELECT 1 FROM pg_catalog.pg_roles g WHERE g.rolname=ANY(ARRAY['firefly_product_definition_guard',
                    'firefly_product_definition_commands','firefly_product_definition_serving','firefly_product_definition_publication_read'])
                    AND pg_catalog.pg_has_role(r.oid,g.oid,'MEMBER'))
        ), relations AS (
            SELECT c.* FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND c.relkind IN ('r','p','v','m','f')
        ), rights AS (
            SELECT r.rolname::TEXT AS role_name,'table/'||t.oid AS object_key,p.privilege,
                pg_catalog.has_table_privilege(r.oid,t.oid,p.privilege) AS allowed FROM roles r CROSS JOIN relations t
                CROSS JOIN unnest(ARRAY['SELECT','INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER','MAINTAIN']) p(privilege)
            UNION ALL SELECT r.rolname::TEXT,'column/'||t.oid||'/'||a.attnum,p.privilege,
                pg_catalog.has_column_privilege(r.oid,t.oid,a.attnum,p.privilege) FROM roles r CROSS JOIN relations t
                JOIN pg_catalog.pg_attribute a ON a.attrelid=t.oid AND a.attnum>0 AND NOT a.attisdropped
                CROSS JOIN unnest(ARRAY['SELECT','INSERT','UPDATE','REFERENCES']) p(privilege)
            UNION ALL SELECT r.rolname::TEXT,'schema/'||n.oid,p.privilege,pg_catalog.has_schema_privilege(r.oid,n.oid,p.privilege)
                FROM roles r CROSS JOIN pg_catalog.pg_namespace n CROSS JOIN unnest(ARRAY['USAGE','CREATE']) p(privilege)
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
            UNION ALL SELECT r.rolname::TEXT,'function/'||f.oid,'EXECUTE',pg_catalog.has_function_privilege(r.oid,f.oid,'EXECUTE')
                FROM roles r CROSS JOIN pg_catalog.pg_proc f JOIN pg_catalog.pg_namespace n ON n.oid=f.pronamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
            UNION ALL SELECT r.rolname::TEXT,'database/'||d.oid,p.privilege,pg_catalog.has_database_privilege(r.oid,d.oid,p.privilege)
                FROM roles r CROSS JOIN pg_catalog.pg_database d CROSS JOIN unnest(ARRAY['CONNECT','CREATE','TEMPORARY']) p(privilege)
                WHERE d.datname=current_database()
            UNION ALL SELECT r.rolname::TEXT,'type/'||t.oid,'USAGE',pg_catalog.has_type_privilege(r.oid,t.oid,'USAGE')
                FROM roles r CROSS JOIN pg_catalog.pg_type t JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
            UNION ALL SELECT r.rolname::TEXT,'sequence/'||q.oid,p.privilege,pg_catalog.has_sequence_privilege(r.oid,q.oid,p.privilege)
                FROM roles r CROSS JOIN pg_catalog.pg_class q JOIN pg_catalog.pg_namespace n ON n.oid=q.relnamespace
                CROSS JOIN unnest(ARRAY['USAGE','SELECT','UPDATE']) p(privilege)
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND q.relkind='S'
        ) SELECT jsonb_agg(to_jsonb(v) ORDER BY role_name,object_key,privilege) INTO current_rights FROM rights v;
        SELECT jsonb_build_object(
            'relations',(SELECT jsonb_agg(jsonb_build_array(c.oid,c.relname,c.relnamespace,c.relkind,c.relfilenode,c.reltype,c.relnatts,
                c.relrowsecurity,c.relforcerowsecurity,c.relpersistence,c.reloptions,c.relispartition) ORDER BY c.oid)
                FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'),
            'columns',(SELECT jsonb_agg(jsonb_build_array(a.attrelid,a.attnum,a.attname,a.atttypid,a.attnotnull,a.attidentity,a.attgenerated,a.attcollation,
                pg_catalog.pg_get_expr(d.adbin,d.adrelid)) ORDER BY a.attrelid,a.attnum) FROM pg_catalog.pg_attribute a
                JOIN pg_catalog.pg_class c ON c.oid=a.attrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND a.attnum>0 AND NOT a.attisdropped),
            'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY p.oid) FROM pg_catalog.pg_policy p
                JOIN pg_catalog.pg_class c ON c.oid=p.polrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' OR n.nspname='firefly_product_definition_private'),
            'triggers',(SELECT jsonb_agg(to_jsonb(t) ORDER BY t.oid) FROM pg_catalog.pg_trigger t
                JOIN pg_catalog.pg_class c ON c.oid=t.tgrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' OR n.nspname='firefly_product_definition_private'),
            'constraints',(SELECT jsonb_agg(to_jsonb(v) ORDER BY v.oid) FROM pg_catalog.pg_constraint v JOIN pg_catalog.pg_namespace n ON n.oid=v.connamespace
                WHERE n.nspname='public' OR n.nspname='firefly_product_definition_private'),
            'indexes',(SELECT jsonb_agg(to_jsonb(i) ORDER BY i.indexrelid) FROM pg_catalog.pg_index i
                JOIN pg_catalog.pg_class c ON c.oid=i.indrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' OR n.nspname='firefly_product_definition_private'),
            'functions',(SELECT jsonb_agg(jsonb_build_array(p.oid,p.proowner,p.proacl,p.prosecdef,p.proconfig,p.provolatile,
                pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(pg_catalog.pg_get_functiondef(p.oid),'UTF8')),'hex')) ORDER BY p.oid) FROM pg_catalog.pg_proc p
                JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' OR n.nspname='firefly_product_definition_private'),
            'other_relation_acl',(SELECT jsonb_agg(jsonb_build_array(c.oid,c.relacl) ORDER BY c.oid) FROM pg_catalog.pg_class c
                JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND c.oid<>ALL(target_oids)),
            'other_column_acl',(SELECT jsonb_agg(jsonb_build_array(a.attrelid,a.attnum,a.attacl) ORDER BY a.attrelid,a.attnum) FROM pg_catalog.pg_attribute a
                JOIN pg_catalog.pg_class c ON c.oid=a.attrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' AND a.attnum>0 AND NOT a.attisdropped AND c.oid<>ALL(target_oids)),
            'memberships',(SELECT jsonb_agg(to_jsonb(a) ORDER BY a.roleid,a.member,a.grantor) FROM pg_catalog.pg_auth_members a)
        ) INTO current_structure;
        IF phase=0 THEN
            owner_before:=current_owners;owner_expected:=owner_before;acl_before:=current_acl;acl_expected:=current_expected_acl;
            rights_before:=current_rights;structure_before:=current_structure;
            FOR item IN SELECT unnest(dependent_relations) AS oid LOOP
                owner_expected:=jsonb_set(owner_expected,ARRAY['relation/'||item.oid],to_jsonb(metadata_owner::BIGINT),FALSE);
            END LOOP;
            FOR item IN SELECT unnest(dependent_types) AS oid LOOP
                owner_expected:=jsonb_set(owner_expected,ARRAY['type/'||item.oid],to_jsonb(metadata_owner::BIGINT),FALSE);
            END LOOP;
            SELECT jsonb_object_agg(c.relname,pg_catalog.pg_get_userbyid(c.relowner)) INTO target_owner_before
                FROM pg_catalog.pg_class c WHERE c.oid=ANY(target_oids);
        ELSE
            owner_after:=current_owners;acl_after:=current_acl;rights_after:=current_rights;structure_after:=current_structure;
            SELECT jsonb_object_agg(c.relname,pg_catalog.pg_get_userbyid(c.relowner)) INTO target_owner_after
                FROM pg_catalog.pg_class c WHERE c.oid=ANY(target_oids);
        END IF;
    END LOOP;
    SELECT jsonb_agg(to_jsonb(a) ORDER BY a.grantor,a.grantee,a.privilege_type,a.is_grantable)
        INTO schema_acl_after FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL
        pg_catalog.aclexplode(COALESCE(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) a WHERE n.nspname='public';
    IF owner_after IS DISTINCT FROM owner_expected OR acl_after IS DISTINCT FROM acl_expected
       OR rights_after IS DISTINCT FROM rights_before OR structure_after IS DISTINCT FROM structure_before
       OR schema_acl_after IS DISTINCT FROM schema_acl_before
       OR pg_catalog.has_schema_privilege(metadata_owner,'public','CREATE') THEN
        RAISE EXCEPTION 'METADATA_OWNER_INVARIANT_CHANGED';
    END IF;
    RAISE NOTICE 'PRODUCT_METADATA_OWNER_PREPARATION %',jsonb_build_object(
        'status','PREPARATION_VERIFIED','mode',preparation_mode,'baseTables',9,'guardTablesUnchanged',3,
        'original20HistoryVerified',TRUE,'schemaCreateRevoked',TRUE,'guardAndRuntimeRightsPreserved',TRUE,
        'objectContractsPreserved',TRUE,'aclOwnerSubstitutionVerified',TRUE,
        'rightsBefore',pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(rights_before::TEXT,'UTF8')),'hex'),'rightsAfter',pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(rights_after::TEXT,'UTF8')),'hex'),
        'structureBefore',pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(structure_before::TEXT,'UTF8')),'hex'),'structureAfter',pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(structure_after::TEXT,'UTF8')),'hex'),
        'ownersBefore',target_owner_before,'ownersAfter',target_owner_after,
        'ownerInventoryBefore',owner_before,'ownerInventoryAfter',owner_after,
        'aclBefore',acl_before,'aclExpected',acl_expected,'aclAfter',acl_after,
        'expectedOldOwnerOid',expected_old_owner,'metadataOwnerOid',metadata_owner,
        'dependentRelationOids',to_jsonb(dependent_relations),'dependentTypeOids',to_jsonb(dependent_types));
END
$preparation$;
COMMIT;
