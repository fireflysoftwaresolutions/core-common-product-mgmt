-- Explicit administrator setup for a fresh dedicated login. Never run as application startup.
\set ON_ERROR_STOP on
\getenv debit_card_read_login PRODUCT_DEBIT_CARD_READ_USERNAME
\getenv debit_card_read_password PRODUCT_DEBIT_CARD_READ_PASSWORD
\getenv debit_card_read_database PRODUCT_DEBIT_CARD_READ_DATABASE
\if :{?debit_card_read_login}
\else
\echo PRODUCT_DEBIT_CARD_READ_USERNAME is required
DO $missing$ BEGIN RAISE EXCEPTION 'DEBIT_CARD_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
\if :{?debit_card_read_password}
\else
\echo PRODUCT_DEBIT_CARD_READ_PASSWORD is required
DO $missing$ BEGIN RAISE EXCEPTION 'DEBIT_CARD_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
\if :{?debit_card_read_database}
\else
\echo PRODUCT_DEBIT_CARD_READ_DATABASE is required
DO $missing$ BEGIN RAISE EXCEPTION 'DEBIT_CARD_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
SELECT length(:'debit_card_read_login')>0 AND length(:'debit_card_read_password')>0
   AND current_database()=:'debit_card_read_database' AS debit_card_setup_inputs_ok
\gset
\if :debit_card_setup_inputs_ok
\else
\echo Nonempty fresh credentials and the exact connected database are required
DO $missing$ BEGIN RAISE EXCEPTION 'DEBIT_CARD_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
BEGIN;
DO $bootstrap$
DECLARE role_row RECORD;
BEGIN
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_debit_card_read';
    IF NOT FOUND THEN
        CREATE ROLE firefly_product_definition_debit_card_read NOLOGIN NOINHERIT
            NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION;
    END IF;
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_debit_card_read';
    IF NOT FOUND OR role_row.rolcanlogin OR role_row.rolinherit OR role_row.rolsuper OR role_row.rolbypassrls
       OR role_row.rolcreatedb OR role_row.rolcreaterole OR role_row.rolreplication
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member=role_row.oid) THEN
        RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='EXACT_DEBIT_CARD_METADATA_ROLE_REQUIRED';
    END IF;
END
$bootstrap$;
GRANT USAGE ON SCHEMA public TO firefly_product_definition_debit_card_read;
SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname=:'debit_card_read_login') AS reader_login_exists
\gset
\if :reader_login_exists
\else
CREATE ROLE :"debit_card_read_login" LOGIN INHERIT NOSUPERUSER NOBYPASSRLS
    NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'debit_card_read_password';
GRANT firefly_product_definition_debit_card_read TO :"debit_card_read_login"
    WITH INHERIT TRUE, SET FALSE, ADMIN FALSE;
GRANT CONNECT ON DATABASE :"debit_card_read_database" TO :"debit_card_read_login";
\endif
SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname=:'debit_card_read_login'
    AND r.rolcanlogin AND r.rolinherit AND NOT r.rolsuper AND NOT r.rolbypassrls AND NOT r.rolcreatedb
    AND NOT r.rolcreaterole AND NOT r.rolreplication
    AND (SELECT count(*) FROM pg_catalog.pg_auth_members a WHERE a.member=r.oid)=1
    AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members a WHERE a.member=r.oid
       AND (a.roleid<>(SELECT oid FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_debit_card_read')
            OR a.admin_option OR a.set_option OR NOT a.inherit_option))) AS reader_identity_exact
\gset
\if :reader_identity_exact
\else
DO $bad$ BEGIN RAISE EXCEPTION 'EXACT_DEBIT_CARD_READER_REQUIRED' USING ERRCODE='42501'; END $bad$;
\endif
SELECT NOT pg_catalog.has_database_privilege(:'debit_card_read_login',current_database(),'CREATE,TEMPORARY')
   AND NOT pg_catalog.has_schema_privilege(:'debit_card_read_login','public','CREATE')
   AS debit_card_setup_defaults_bounded
\gset
\if :debit_card_setup_defaults_bounded
\else
\echo Existing database/schema PUBLIC defaults must already meet the reviewed bounded database contract
DO $missing$ BEGIN RAISE EXCEPTION 'DEBIT_CARD_BOOTSTRAP_DEFAULTS_REQUIRED' USING ERRCODE='42501'; END $missing$;
\endif
COMMIT;
