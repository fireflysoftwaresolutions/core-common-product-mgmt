-- Explicit administrator setup for a fresh dedicated login. Never run as application startup.
\set ON_ERROR_STOP on
\getenv insurance_quote_read_login PRODUCT_INSURANCE_QUOTE_READ_USERNAME
\getenv insurance_quote_read_password PRODUCT_INSURANCE_QUOTE_READ_PASSWORD
\getenv insurance_quote_read_database PRODUCT_INSURANCE_QUOTE_READ_DATABASE
\if :{?insurance_quote_read_login}
\else
\echo PRODUCT_INSURANCE_QUOTE_READ_USERNAME is required
DO $missing$ BEGIN RAISE EXCEPTION 'INSURANCE_QUOTE_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
\if :{?insurance_quote_read_password}
\else
\echo PRODUCT_INSURANCE_QUOTE_READ_PASSWORD is required
DO $missing$ BEGIN RAISE EXCEPTION 'INSURANCE_QUOTE_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
\if :{?insurance_quote_read_database}
\else
\echo PRODUCT_INSURANCE_QUOTE_READ_DATABASE is required
DO $missing$ BEGIN RAISE EXCEPTION 'INSURANCE_QUOTE_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
SELECT length(:'insurance_quote_read_login')>0 AND length(:'insurance_quote_read_password')>0
   AND current_database()=:'insurance_quote_read_database' AS insurance_quote_setup_inputs_ok
\gset
\if :insurance_quote_setup_inputs_ok
\else
\echo Nonempty fresh credentials and the exact connected database are required
DO $missing$ BEGIN RAISE EXCEPTION 'INSURANCE_QUOTE_BOOTSTRAP_INPUTS_REQUIRED' USING ERRCODE='22023'; END $missing$;
\endif
BEGIN;
DO $bootstrap$
DECLARE role_row RECORD;
BEGIN
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_insurance_quote_read';
    IF NOT FOUND THEN
        CREATE ROLE firefly_product_definition_insurance_quote_read NOLOGIN NOINHERIT
            NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION;
    END IF;
    SELECT * INTO role_row FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_insurance_quote_read';
    IF NOT FOUND OR role_row.rolcanlogin OR role_row.rolinherit OR role_row.rolsuper OR role_row.rolbypassrls
       OR role_row.rolcreatedb OR role_row.rolcreaterole OR role_row.rolreplication
       OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member=role_row.oid) THEN
        RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='EXACT_INSURANCE_QUOTE_METADATA_ROLE_REQUIRED';
    END IF;
END
$bootstrap$;
GRANT USAGE ON SCHEMA public TO firefly_product_definition_insurance_quote_read;
SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname=:'insurance_quote_read_login') AS reader_login_exists
\gset
\if :reader_login_exists
\else
CREATE ROLE :"insurance_quote_read_login" LOGIN INHERIT NOSUPERUSER NOBYPASSRLS
    NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'insurance_quote_read_password';
GRANT firefly_product_definition_insurance_quote_read TO :"insurance_quote_read_login"
    WITH INHERIT TRUE, SET FALSE, ADMIN FALSE;
GRANT CONNECT ON DATABASE :"insurance_quote_read_database" TO :"insurance_quote_read_login";
\endif
SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname=:'insurance_quote_read_login'
    AND r.rolcanlogin AND r.rolinherit AND NOT r.rolsuper AND NOT r.rolbypassrls AND NOT r.rolcreatedb
    AND NOT r.rolcreaterole AND NOT r.rolreplication
    AND (SELECT count(*) FROM pg_catalog.pg_auth_members a WHERE a.member=r.oid)=1
    AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members a WHERE a.member=r.oid
       AND (a.roleid<>(SELECT oid FROM pg_catalog.pg_roles WHERE rolname='firefly_product_definition_insurance_quote_read')
            OR a.admin_option OR a.set_option OR NOT a.inherit_option))) AS reader_identity_exact
\gset
\if :reader_identity_exact
\else
DO $bad$ BEGIN RAISE EXCEPTION 'EXACT_INSURANCE_QUOTE_READER_REQUIRED' USING ERRCODE='42501'; END $bad$;
\endif
SELECT NOT pg_catalog.has_database_privilege(:'insurance_quote_read_login',current_database(),'CREATE,TEMPORARY')
   AND NOT pg_catalog.has_schema_privilege(:'insurance_quote_read_login','public','CREATE')
   AS insurance_quote_setup_defaults_bounded
\gset
\if :insurance_quote_setup_defaults_bounded
\else
\echo Existing database/schema PUBLIC defaults must already meet the reviewed bounded database contract
DO $missing$ BEGIN RAISE EXCEPTION 'INSURANCE_QUOTE_BOOTSTRAP_DEFAULTS_REQUIRED' USING ERRCODE='42501'; END $missing$;
\endif
COMMIT;
